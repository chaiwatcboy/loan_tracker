                for (let i = 0; i < n; i++) {
                    if (p[i] <= 0) continue;
                    let activeR = (i === 0 && monthIndex > 36) ? post3YearRate1 : r[i];
                    monthlyInts[i] = p[i] * activeR;
                    totalInterestUnderBudget += monthlyInts[i];
                    payments[i] = Math.min(p[i] + monthlyInts[i], minP[i]);
                    availableBudget -= payments[i];
                }

                availableBudget = Math.max(0, availableBudget);

                if (availableBudget > 0) {
                    for (let idx of priorityIndices) {
                        if (p[idx] <= 0) continue;
                        const neededToFinish = (p[idx] + monthlyInts[idx]) - payments[idx];
                        if (neededToFinish > 0) {
                            const extra = Math.min(availableBudget, neededToFinish);
                            payments[idx] += extra;
                            availableBudget -= extra;
                            if (availableBudget <= 0) break;
                        }
                    }
                }

                const prinPaid = new Float64Array(n);
                const endP = new Float64Array(n);
                for (let i = 0; i < n; i++) {
                    if (p[i] > 0) {
                        prinPaid[i] = Math.max(0, payments[i] - monthlyInts[i]);
                        endP[i] = Math.max(0, p[i] - prinPaid[i]);
                    }
                }

                if (selectedView === 'all') {
                    const rowPay = payments.reduce((a, b) => a + b, 0);
                    const rowInt = monthlyInts.reduce((a, b) => a + b, 0);
                    const rowPrin = prinPaid.reduce((a, b) => a + b, 0);
                    const rowEnd = endP.reduce((a, b) => a + b, 0);

                    let statusBadge = '<span class="text-slate-400">ผ่อนตามแผน</span>';
                    if (monthIndex === 36 && window.loans.length > 0) {
                        statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">🔄 ครบ 3 ปี Retention</span>';
                    } else if (rowEnd === 0) {
                        statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-100 text-indigo-700">🏆 หมดหนี้ครบ!</span>';
                    }

                    rows.push({
                        idx: monthIndex,
                        dateStr: monthStr,
                        start: totalStartBalance,
                        pay: rowPay,
                        interest: rowInt,
                        principal: rowPrin,
                        end: rowEnd,
                        status: statusBadge
                    });
                } else {
                    const loanId = parseInt(selectedView);
                    const targetIdx = window.loans.findIndex(l => l.id === loanId);
                    if (targetIdx !== -1) {
                        const startVal = p[targetIdx];
                        const payVal = payments[targetIdx];
                        const intVal = monthlyInts[targetIdx];
                        const prinVal = prinPaid[targetIdx];
                        const endVal = endP[targetIdx];
                        let statusBadge = endVal === 0 ? '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700">ปิดจบแล้ว</span>' : '<span class="text-slate-400">ผ่อนปกติ</span>';

                        rows.push({
                            idx: monthIndex,
                            dateStr: monthStr,
                            start: startVal,
                            pay: payVal,
                            interest: intVal,
                            principal: prinVal,
                            end: endVal,
                            status: statusBadge
                        });
                    }
                }

                if (monthIndex % (monthIndex > 120 ? 12 : monthIndex > 48 ? 6 : 3) === 0 || !p.some(v => v > 0.01)) {
                    chartLabels.push(monthStr);
                    chartDataBudget.push(Math.round(endP.reduce((a, b) => a + b, 0)));
                }

                for (let i = 0; i < n; i++) p[i] = endP[i];
            }

            window.lastComputedSchedule = rows;

            while (baseP.some(val => val > 0.01) && baseMonths < 420) {
                baseMonths++;
                for (let i = 0; i < n; i++) {
                    if (baseP[i] <= 0) continue;
                    let activeR = (i === 0 && baseMonths > 36) ? post3YearRate1 : r[i];
                    const bInt = baseP[i] * activeR;
                    totalInterestBaseline += bInt;
                    const bPay = Math.min(baseP[i] + bInt, minP[i]);
                    baseP[i] = Math.max(0, baseP[i] - Math.max(0, bPay - bInt));
                }
            }

            for (let i = 1; i < chartLabels.length; i++) {
                chartDataBaseline.push(Math.max(0, Math.round(totalInitialP - (totalInitialP * (i / chartLabels.length) * 0.4))));
            }

            renderChart(chartLabels, chartDataBudget, chartDataBaseline);

            const targetPayoffDate = new Date(startDate.getFullYear(), startDate.getMonth() + monthIndex - 1, 1);
            const targetDateStr = `${thaiFullMonths[targetPayoffDate.getMonth()]} ${targetPayoffDate.getFullYear() + 543}`;
            const years = Math.floor(monthIndex / 12);
            const remMonths = monthIndex % 12;

            const statDate = document.getElementById('stat-target-date');
            const statDur = document.getElementById('stat-target-duration');
            const schedDur = document.getElementById('schedule-duration-display');
            const statInt = document.getElementById('stat-interest-saved');
            const statIntDesc = document.getElementById('stat-interest-saved-desc');

            if (statDate) statDate.innerText = targetDateStr;
            if (statDur) statDur.innerText = `อีก ${years} ปี ${remMonths} เดือน (${monthIndex} งวด)`;
            if (schedDur) schedDur.innerText = `${years} ปี ${remMonths} เดือน (${monthIndex} งวด)`;
            if (statInt) statInt.innerText = formatMoney(Math.max(0, totalInterestBaseline - totalInterestUnderBudget));
            if (statIntDesc) statIntDesc.innerText = `เทียบกับจ่ายขั้นต่ำ (${totalMin.toLocaleString()} บ.)`;

            const displayLimit = isScheduleExpanded ? rows.length : Math.min(24, rows.length);
            const rowsCountEl = document.getElementById('schedule-rows-count');
            if (rowsCountEl) rowsCountEl.innerText = isScheduleExpanded ? `แสดงครบทั้งหมด ${rows.length} งวด` : `แสดง 24 งวดแรก (จากทั้งหมด ${rows.length} งวด)`;

            for (let i = 0; i < displayLimit; i++) {
                const row = rows[i];
                const tr = document.createElement('tr');
                tr.className = (i % 2 === 0 ? "bg-white" : "bg-slate-50/60") + " hover:bg-indigo-50/40 transition";
                tr.innerHTML = `
                    <td class="px-4 py-2 text-center text-slate-500 font-medium">${row.idx}</td>
                    <td class="px-4 py-2 font-semibold text-slate-800 whitespace-nowrap">${row.dateStr}</td>
                    <td class="px-4 py-2 text-right text-slate-600">${formatMoney(row.start)}</td>
                    <td class="px-4 py-2 text-right font-bold text-slate-900">${formatMoney(row.pay)}</td>
                    <td class="px-4 py-2 text-right text-amber-600">${formatMoney(row.interest)}</td>
                    <td class="px-4 py-2 text-right text-emerald-600 font-semibold">${formatMoney(row.principal)}</td>
                    <td class="px-4 py-2 text-right font-bold text-slate-900">${formatMoney(row.end)}</td>
                    <td class="px-4 py-2 text-center whitespace-nowrap">${row.status}</td>
                `;
                tbody.appendChild(tr);
            }
        };

        function updateQuickBudgetButtons(totalMin) {
            const container = document.getElementById('quick-budget-buttons-container');
            if (!container) return;

            const b1 = totalMin;
            const b2 = Math.round((totalMin * 1.35) / 100) * 100;
            const b3 = Math.round((totalMin * 1.55) / 100) * 100;

            container.innerHTML = `
                <button type="button" onclick="setQuickBudget(${b1})" class="px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-white hover:bg-slate-200 border border-slate-200 text-slate-700 transition">ขั้นต่ำ ${b1.toLocaleString()}</button>
                <button type="button" onclick="setQuickBudget(${b2})" class="px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-white hover:bg-slate-200 border border-slate-200 text-slate-700 transition">แผน ${b2.toLocaleString()}</button>
                <button type="button" onclick="setQuickBudget(${b3})" class="px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 text-indigo-700 transition">แผน ${b3.toLocaleString()} (แนะนำ)</button>
            `;
        }

        window.setQuickBudget = function(val) {
            const input = document.getElementById('schedule-budget-input');
            if (input) input.value = val;
            window.renderAmortizationSchedule();
            scrollToSchedule();
        };

        window.onScheduleBudgetChange = function() {
            window.renderAmortizationSchedule();
        };

        window.toggleScheduleExpansion = function() {
            isScheduleExpanded = !isScheduleExpanded;
            const btn = document.getElementById('schedule-toggle-btn');
            if (btn) {
                btn.innerHTML = isScheduleExpanded ? `<span>ย่อตารางเหลือ 24 งวด</span> <i class="ph-bold ph-caret-up"></i>` : `<span>ดูตารางทั้งหมดจนหมดหนี้</span> <i class="ph-bold ph-caret-down"></i>`;
            }
            window.renderAmortizationSchedule();
        };

        window.openDirectEditModal = function(loanId) {
            activeEditLoanId = loanId;
            const loan = window.loans.find(l => l.id === loanId);
            if (!loan) return;
            document.getElementById('edit-modal-title').innerText = `แก้ไขยอดเงินต้น: ${loan.name}`;
            document.getElementById('edit-modal-principal').value = loan.principal;
            document.getElementById('edit-modal-date').value = loan.lastPaidDate;
            document.getElementById('edit-loan-modal').classList.remove('hidden');
            document.getElementById('edit-loan-modal').classList.add('flex');
        };

        window.closeEditModal = function() {
            document.getElementById('edit-loan-modal').classList.add('hidden');
            document.getElementById('edit-loan-modal').classList.remove('flex');
            activeEditLoanId = null;
        };

        window.saveDirectEdit = function() {
            const newPrincipal = parseFloat(document.getElementById('edit-modal-principal').value);
            const newDate = document.getElementById('edit-modal-date').value;

            if (isNaN(newPrincipal) || newPrincipal < 0 || !newDate) {
                showToast("กรุณากรอกยอดเงินต้นและวันที่ให้ถูกต้อง", "error");
                return;
            }

            const loan = window.loans.find(l => l.id === activeEditLoanId);
            if (!loan) return;
            const oldPrincipal = loan.principal;
            loan.principal = newPrincipal;
            loan.lastPaidDate = newDate;

            window.historyLogs.push({
                id: Date.now(),
                date: newDate,
                loanName: loan.name,
                loanId: loan.id,
                payment: 0,
                interest: 0,
                principalPaid: oldPrincipal - newPrincipal,
                remainingPrincipal: newPrincipal,
                note: "แก้ไขตัวเลขเงินต้นตรง"
            });

            closeEditModal();
            window.renderOverview();
            window.renderHistoryTable();
            window.renderAmortizationSchedule();
            showToast("อัปเดตยอดเงินต้นตรงตามระบบเรียบร้อย");
        };

        window.openSimulationModal = function() {
            document.getElementById('sim-modal').classList.remove('hidden');
            document.getElementById('sim-modal').classList.add('flex');
            updateSimulation();
        };

        window.closeSimulationModal = function() {
            document.getElementById('sim-modal').classList.add('hidden');
            document.getElementById('sim-modal').classList.remove('flex');
        };

        window.updateSimulation = function() {
            const slider = document.getElementById('sim-budget-slider');
            const monthlyBudget = parseFloat(slider.value);
            document.getElementById('sim-budget-display').innerText = formatMoney(monthlyBudget) + " / เดือน";

            const sim = simulatePayoffScenario(monthlyBudget);
            const years = Math.floor(sim.months / 12);
            const remainingMonths = sim.months % 12;
            const ageAtFinish = 35.0 + (sim.months / 12);

            const container = document.getElementById('sim-results');
            container.innerHTML = `
                <div class="bg-indigo-50/70 p-4 rounded-2xl border border-indigo-100">
                    <div class="text-xs text-indigo-700 font-semibold">ระยะเวลาจนหมดหนี้</div>
                    <div class="text-xl font-black text-indigo-950 mt-1">${years} ปี ${remainingMonths} เดือน</div>
                    <div class="text-[11px] text-slate-500 mt-1">${sim.months} งวด ผ่อนสม่ำเสมอ</div>
                </div>

                <div class="bg-emerald-50/70 p-4 rounded-2xl border border-emerald-100">
                    <div class="text-xs text-emerald-700 font-semibold">อายุเมื่อปลดหนี้สำเร็จ</div>
                    <div class="text-xl font-black text-emerald-950 mt-1">~${ageAtFinish.toFixed(1)} ปี</div>
                    <div class="text-[11px] font-bold ${ageAtFinish < 50 ? 'text-emerald-600' : 'text-rose-600'} mt-1">
                        ${ageAtFinish < 50 ? '🎉 ทะลุเป้าก่อนอายุ 50 ปี!' : '⚠️ เกินเป้าหมาย 50 ปี'}
                    </div>
                </div>

                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200">
                    <div class="text-xs text-slate-500 font-semibold">ดอกเบี้ยรวมที่ต้องจ่าย</div>
                    <div class="text-xl font-black text-slate-900 mt-1">${formatMoney(sim.totalInterest)}</div>
                    <div class="text-[11px] text-slate-500 mt-1">คำนวณตามอัตราดอกเบี้ยจริง</div>
                </div>
            `;
        };

        window.openBackupModal = function() {
            const modal = document.getElementById('backup-modal');
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
        };

        window.closeBackupModal = function() {
            const modal = document.getElementById('backup-modal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        };

        window.onRetentionModeChange = function() {
            currentRetentionMode = document.getElementById('retention-mode-select').value;
            window.renderAmortizationSchedule();
            window.renderMilestones();
            showToast("อัปเดตการจำลอง Retention เรียบร้อย");
        };

        window.exportDataJSON = function() {
            const exportObject = {
                app: "LoanTrackerTH",
                version: "2.1",
                planOwnerName: window.planOwnerName,
                exportedAt: new Date().toISOString(),
                loans: window.loans,
                historyLogs: window.historyLogs
            };
            const jsonStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(exportObject, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", jsonStr);
            downloadAnchor.setAttribute("download", `loan_backup_${new Date().toISOString().split('T')[0]}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
            showToast("ส่งออกไฟล์สำรอง JSON เรียบร้อย");
        };

        window.handleFileImport = function(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const parsed = JSON.parse(e.target.result);
                    if (parsed && parsed.loans && Array.isArray(parsed.loans)) {
                        window.loans = parsed.loans;
                        if (parsed.planOwnerName) {
                            window.planOwnerName = parsed.planOwnerName;
                            const ownerBadge = document.getElementById('owner-name-display');
                            if (ownerBadge) ownerBadge.innerText = window.planOwnerName;
                        }
                        if (Array.isArray(parsed.historyLogs)) {
                            window.historyLogs = parsed.historyLogs;
                        }
                        updateLoanDropdowns();
                        window.renderOverview();
                        window.renderMilestones();
                        window.renderHistoryTable();
                        window.renderAmortizationSchedule();
                        closeBackupModal();
                        showToast("กู้คืนข้อมูลจากไฟล์สำรองสำเร็จสมบูรณ์!");
                    } else {
                        showToast("รูปแบบไฟล์ JSON ไม่ถูกต้อง", "error");
                    }
                } catch (err) {
                    showToast("ไม่สามารถอ่านไฟล์ JSON ได้", "error");
                }
            };
            reader.readAsText(file);
            event.target.value = '';
        };

        window.exportHistoryCSV = function() {
            if (!window.historyLogs || window.historyLogs.length === 0) {
                showToast("ยังไม่มีประวัติการชำระเงินให้ดาวน์โหลด", "error");
                return;
            }

            let csvContent = "\uFEFFวันที่,รายการหนี้,ยอดชำระ(บาท),หักดอกเบี้ย(บาท),หักเงินต้น(บาท),เงินต้นคงเหลือ(บาท),หมายเหตุ\n";
            window.historyLogs.forEach(row => {
                csvContent += `"${row.date}","${row.loanName}",${row.payment},${row.interest},${row.principalPaid},${row.remainingPrincipal},"${row.note || ''}"\n`;
            });

            downloadCSVFile(csvContent, `loan_payment_history_${new Date().toISOString().split('T')[0]}.csv`);
            showToast("ดาวน์โหลดประวัติเป็นไฟล์ CSV สำเร็จ");
        };

        window.exportScheduleCSV = function() {
            if (!window.lastComputedSchedule || window.lastComputedSchedule.length === 0) {
                showToast("ไม่พบข้อมูลตารางจำลอง", "error");
                return;
            }

            let csvContent = "\uFEFFงวดที่,เดือน/ปี,เงินต้นยกมา(บาท),ยอดผ่อนรวม(บาท),ตัดดอกเบี้ย(บาท),ตัดเงินต้น(บาท),เงินต้นคงเหลือ(บาท)\n";
            window.lastComputedSchedule.forEach(r => {
                csvContent += `${r.idx},"${r.dateStr}",${r.start.toFixed(2)},${r.pay.toFixed(2)},${r.interest.toFixed(2)},${r.principal.toFixed(2)},${r.end.toFixed(2)}\n`;
            });

            downloadCSVFile(csvContent, `loan_amortization_schedule_${new Date().toISOString().split('T')[0]}.csv`);
            showToast("ดาวน์โหลดตารางผ่อนเป็น CSV เรียบร้อย");
        };

        function downloadCSVFile(content, fileName) {
            const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            const url = URL.createObjectURL(blob);
            link.setAttribute("href", url);
            link.setAttribute("download", fileName);
            document.body.appendChild(link);
            link.click();
            link.remove();
        }

        window.renderHistoryTable = function() {
            const tbody = document.getElementById('history-table-body');
            tbody.innerHTML = '';

            if (window.historyLogs.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="text-center py-8 text-slate-400 text-xs">ยังไม่มีประวัติการชำระเงิน</td>
                    </tr>
                `;
                return;
            }

            window.historyLogs.slice().reverse().forEach(item => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition";
                tr.innerHTML = `
                    <td class="px-6 py-3.5 text-xs text-slate-600 font-medium whitespace-nowrap">${item.date}</td>
                    <td class="px-6 py-3.5 text-xs font-semibold text-slate-900">${item.loanName}</td>
                    <td class="px-6 py-3.5 text-xs text-right font-bold text-slate-800">${formatMoney(item.payment)}</td>
                    <td class="px-6 py-3.5 text-xs text-right text-amber-600">${formatMoney(item.interest)}</td>
                    <td class="px-6 py-3.5 text-xs text-right text-emerald-600 font-semibold">${formatMoney(item.principalPaid)}</td>
                    <td class="px-6 py-3.5 text-xs text-right font-bold text-slate-900">${formatMoney(item.remainingPrincipal)}</td>
                    <td class="px-6 py-3.5 text-xs text-center text-slate-500">${item.note || '-'}</td>
                `;
                tbody.appendChild(tr);
            });
        };

        function openCustomConfirm(title, desc, onConfirm) {
            document.getElementById('confirm-title').innerText = title;
            document.getElementById('confirm-desc').innerText = desc;
            confirmCallback = onConfirm;
            const btn = document.getElementById('confirm-action-btn');
            btn.onclick = () => {
                if (confirmCallback) confirmCallback();
                closeConfirmModal();
            };
            document.getElementById('confirm-modal').classList.remove('hidden');
            document.getElementById('confirm-modal').classList.add('flex');
        }

        function closeConfirmModal() {
            document.getElementById('confirm-modal').classList.add('hidden');
            document.getElementById('confirm-modal').classList.remove('flex');
            confirmCallback = null;
        }

        window.confirmClearHistoryDialog = function() {
            openCustomConfirm("ล้างประวัติการชำระเงิน", "คุณต้องการลบประวัติการทำรายการทั้งหมดใช่หรือไม่?", () => {
                window.historyLogs = [];
                window.renderHistoryTable();
                showToast("ล้างประวัติการทำรายการเรียบร้อย", "info");
            });
        };

        window.confirmResetDialog = function() {
            openCustomConfirm("รีเซ็ตค่าเริ่มต้น", "คุณต้องการรีเซ็ตยอดหนี้กลับไปเป็นค่าเริ่มต้น ณ กันยายน 2569 หรือไม่?", () => {
                window.loans = JSON.parse(JSON.stringify(INITIAL_LOANS));
                window.planOwnerName = "คุณ (แผนหลัก)";
                const ownerBadge = document.getElementById('owner-name-display');
                if (ownerBadge) ownerBadge.innerText = window.planOwnerName;
                updateLoanDropdowns();
                window.renderOverview();
                window.renderHistoryTable();
                window.renderAmortizationSchedule();
                showToast("รีเซ็ตกลับเป็นค่าเริ่มต้นสำเร็จ");
            });
        };

        window.addEventListener('DOMContentLoaded', () => {
            const today = new Date().toISOString().split('T')[0];
            const payDateEl = document.getElementById('pay-date');
            if (payDateEl) payDateEl.value = today;
            updateLoanDropdowns();
            window.renderOverview();
            window.renderMilestones();
            window.renderHistoryTable();
            window.renderAmortizationSchedule();
        });
    </script>
