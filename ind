        function calculatePaymentSplits(loan, payDate, amount, manualPrincipal) {
            const days = Math.max(1, getDaysDifference(loan.lastPaidDate, payDate));
            const dailyInterest = calculateDailyInterest(loan.principal, loan.rate);
            const interest = Math.round(dailyInterest * days * 100) / 100;

            let principalPaid = 0;
            let newPrincipal = 0;

            if (manualPrincipal > 0) {
                newPrincipal = manualPrincipal;
                principalPaid = Math.max(0, loan.principal - manualPrincipal);
            } else {
                const interestToDeduct = Math.min(amount, interest);
                principalPaid = Math.max(0, amount - interestToDeduct);
                newPrincipal = Math.max(0, loan.principal - principalPaid);
            }

            return {
                days,
                interest,
                principalPaid,
                newPrincipal
            };
        }

