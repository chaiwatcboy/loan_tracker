<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>โปรแกรมคำนวณและติดตามหนี้บ้าน</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Phosphor Icons for UI Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <!-- Chart.js CDN for interactive loan decline & comparison chart -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        }
                    },
                    fontFamily: {
                        sans: ['Sarabun', 'Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sarabun:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Sarabun', 'Inter', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        .schedule-scroll::-webkit-scrollbar {
            height: 6px;
            width: 6px;
        }
        .schedule-scroll::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 9999px;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen pb-16">

    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center text-white shadow-indigo-200 shadow-md">
                    <i class="ph-bold ph-house-line text-2xl"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-lg font-bold text-slate-900 leading-tight">โปรแกรมคำนวณและติดตามหนี้บ้าน</h1>
                        <span id="plan-owner-badge" class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200 flex items-center gap-1">
                            <i class="ph-bold ph-user"></i> <span id="owner-name-display">แผนของคุณ</span>
                        </span>
                        <span id="storage-status-badge" class="px-2 py-0.5 rounded-full text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center gap-1">
                            <i class="ph-bold ph-cloud-check text-emerald-600"></i> พร้อมใช้งาน
                        </span>
                    </div>
                    <p class="text-xs text-slate-500">ปรับแต่งสัญญาหนี้ได้อิสระ บันทึกยอดจริง พร้อมคำนวณวันหมดหนี้เรียลไทม์</p>
                </div>
            </div>
            
            <div class="flex items-center gap-2 flex-wrap">
                <button type="button" onclick="scrollToSchedule()" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs sm:text-sm font-semibold flex items-center gap-1.5 transition">
                    <i class="ph-bold ph-table"></i>
                    <span>ตารางรายเดือน</span>
                </button>
                <button type="button" onclick="openSimulationModal()" class="px-3.5 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 rounded-xl text-xs sm:text-sm font-semibold flex items-center gap-1.5 transition">
                    <i class="ph-bold ph-chart-line-up"></i>
                    <span>จำลองเป้าหมาย 50 ปี</span>
                </button>
                <button type="button" onclick="openBackupModal()" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs sm:text-sm font-semibold flex items-center gap-1.5 transition shadow-sm border border-slate-200" title="สำรอง/กู้คืนข้อมูล">
                    <i class="ph-bold ph-floppy-disk text-base text-indigo-600"></i>
                    <span class="hidden sm:inline">สำรองข้อมูล</span>
                </button>
                <button type="button" onclick="openNewUserModal()" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs sm:text-sm font-semibold flex items-center gap-1.5 transition shadow-sm shadow-emerald-200">
                    <i class="ph-bold ph-user-gear text-base"></i>
                    <span>ผู้ใช้ใหม่ / ตั้งค่าแผน</span>
                </button>
                <button type="button" onclick="confirmResetDialog()" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-xl transition" title="รีเซ็ตค่าเริ่มต้น (ก.ย. 69)">
                    <i class="ph-bold ph-arrow-counter-clockwise text-lg"></i>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
        <!-- Total Overview Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                <div class="flex items-center justify-between text-slate-500 text-xs font-medium">
                    <span>ยอดหนี้รวมคงเหลือจริง</span>
                    <i class="ph-fill ph-wallet text-indigo-500 text-base"></i>
                </div>
                <div class="mt-2 text-2xl font-bold text-slate-900 tracking-tight" id="total-balance-display">฿0.00</div>
                <div class="mt-1 flex items-center gap-1 text-xs text-emerald-600 font-medium">
                    <i class="ph-bold ph-check-circle"></i>
                    <span id="sync-time-display">พร้อมใช้งาน</span>
                </div>
            </div>

            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                <div class="flex items-center justify-between text-slate-500 text-xs font-medium">
                    <span>วันที่คาดว่าจะหมดหนี้ (ตามงบจำลอง)</span>
                    <i class="ph-fill ph-calendar-star text-emerald-500 text-base"></i>
                </div>
                <div class="mt-2 text-2xl font-bold text-emerald-600 tracking-tight" id="stat-target-date">-</div>
                <div class="mt-1 text-xs text-slate-500" id="stat-target-duration">คำนวณตามงบผ่อนต่อเดือน</div>
            </div>

            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                <div class="flex items-center justify-between text-slate-500 text-xs font-medium">
                    <span>ประหยัดดอกเบี้ยได้จากการโปะ</span>
                    <i class="ph-fill ph-piggy-bank text-amber-500 text-base"></i>
                </div>
                <div class="mt-2 text-2xl font-bold text-amber-600 tracking-tight" id="stat-interest-saved">฿0.00</div>
                <div class="mt-1 text-xs text-slate-500" id="stat-interest-saved-desc">เทียบกับการจ่ายขั้นต่ำเดิม</div>
            </div>

            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                <div class="flex items-center justify-between text-slate-500 text-xs font-medium">
                    <span>ลำดับโปะด่วน (Debt Avalanche)</span>
                    <i class="ph-fill ph-fire text-rose-500 text-base"></i>
                </div>
                <div class="mt-2 text-base font-bold text-rose-600 truncate" id="urgent-avalanche-display">-</div>
                <div class="mt-1 text-xs text-slate-500" id="urgent-avalanche-desc">ดอกเบี้ยแพงสุด ทุ่มโปะให้จบก่อน</div>
            </div>
        </div>

        <!-- Milestone Tracker -->
        <section class="bg-gradient-to-r from-indigo-900 via-indigo-850 to-slate-900 rounded-2xl p-5 sm:p-6 text-white shadow-md relative overflow-hidden">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-indigo-700/50 gap-2">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-xl bg-amber-400/20 text-amber-300 flex items-center justify-center text-xl">
                        <i class="ph-fill ph-trophy"></i>
                    </div>
                    <div>
                        <h2 class="text-base sm:text-lg font-bold tracking-tight">เป้าหมายย่อยพิชิตหนี้ (Milestone Tracker)</h2>
                        <p class="text-xs text-indigo-200">ซอยเป้าหมายใหญ่เป็นชัยชนะเล็กๆ ในแต่ละสัญญาเพื่อสร้างกำลังใจ</p>
                    </div>
                </div>
                <span class="text-xs font-semibold px-3 py-1 rounded-full bg-indigo-500/30 border border-indigo-400/30 text-indigo-200 self-start sm:self-auto flex items-center gap-1.5">
                    <i class="ph-bold ph-target"></i> ปลอดหนี้ทุกก้อน
                </span>
            </div>

            <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5" id="milestones-container">
                <!-- Dynamically populated by JS -->
            </div>
        </section>

        <!-- Section: Matrix Compare Budgets & Reverse Age Goal Calculator -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-100 gap-2">
                    <div>
                        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                            <i class="ph-bold ph-chart-bar text-indigo-600"></i>
                            เปรียบเทียบยอดผ่อน 5 ระดับ (โปะเท่าไรคุ้มที่สุด?)
                        </h2>
                        <p class="text-xs text-slate-500">เปรียบเทียบวันหมดหนี้ ดอกเบี้ยรวม และระยะเวลาที่ลดลงชัดเจนในตารางเดียว</p>
                    </div>
                    <span id="matrix-sweet-spot-badge" class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 text-amber-800 border border-amber-200 flex items-center gap-1 self-start sm:self-auto">
                        <i class="ph-fill ph-star text-amber-500"></i> แนะนำ: Sweet Spot
                    </span>
                </div>

                <div class="overflow-x-auto schedule-scroll border border-slate-200 rounded-xl">
                    <table class="w-full text-left text-xs min-w-[550px]">
                        <thead class="bg-slate-100 text-slate-600 font-semibold uppercase">
                            <tr>
                                <th class="px-3.5 py-2.5">ยอดผ่อน/ด.</th>
                                <th class="px-3.5 py-2.5">คาดว่าหมดหนี้</th>
                                <th class="px-3.5 py-2.5 text-right">ดอกเบี้ยรวม</th>
                                <th class="px-3.5 py-2.5 text-right text-emerald-700">ประหยัดดอกเบี้ย</th>
                                <th class="px-3.5 py-2.5 text-right text-indigo-700 font-bold">ลดเวลาได้</th>
                                <th class="px-3.5 py-2.5 text-center">เลือกใช้</th>
                            </tr>
                        </thead>
                        <tbody id="matrix-comparison-tbody" class="divide-y divide-slate-150">
                            <!-- Populated by JS -->
                        </tbody>
                    </table>
                </div>
                <div class="text-[11px] text-slate-500 flex items-center gap-1.5 pt-1">
                    <i class="ph-bold ph-info text-indigo-500"></i>
                    <span>การโปะเพิ่มจากยอดขั้นต่ำช่วยร่นเวลาหนี้หายไปหลายปีและประหยัดดอกเบี้ยได้หลักแสนบาท</span>
                </div>
            </div>

            <!-- Reverse Goal Calculator & Prepayment Impact Tool -->
            <div class="bg-gradient-to-br from-indigo-50/90 to-white rounded-2xl border border-indigo-200 shadow-sm p-5 sm:p-6 space-y-4 flex flex-col justify-between">
                <div>
                    <div class="flex items-center gap-2 pb-2 border-b border-indigo-100">
                        <div class="w-8 h-8 rounded-lg bg-indigo-600 text-white flex items-center justify-center text-lg">
                            <i class="ph-bold ph-sparkle"></i>
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-slate-900">คำนวณเป้าหมายตามอายุที่ต้องการ</h3>
                            <p class="text-[11px] text-slate-500">คำนวณย้อนกลับว่าต้องจ่ายเดือนละเท่าไร</p>
                        </div>
                    </div>

                    <div class="mt-4 space-y-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">ต้องการหมดหนี้ตอนอายุ (ปี):</label>
                            <div class="flex items-center gap-2">
                                <input type="number" id="target-age-input" value="40" min="30" max="65" step="1" oninput="calculateReverseTargetPayoff()"
                                       class="w-full bg-white border border-slate-300 rounded-xl px-3 py-2 text-sm font-bold text-indigo-600 focus:ring-2 focus:ring-indigo-500">
                                <button type="button" onclick="calculateReverseTargetPayoff()" class="px-3 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-xl transition">
                                    คำนวณ
                                </button>
                            </div>
                        </div>

                        <div id="target-age-result" class="p-3.5 bg-white rounded-xl border border-indigo-100 space-y-1.5 text-xs shadow-sm">
                            <!-- Populated by JS -->
                        </div>
                    </div>
                </div>

                <!-- Instant Prepay Savings Tool -->
                <div class="pt-3 border-t border-indigo-100/80">
                    <div class="font-bold text-xs text-slate-800 flex items-center gap-1.5 mb-1.5">
                        <i class="ph-bold ph-calculator text-amber-500"></i>
                        <span>ถ้าเดือนนี้โปะเพิ่มทันที จะลดดอกเบี้ยเท่าไร?</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="number" id="extra-pay-quick-input" placeholder="เช่น 1000 หรือ 2000" value="1000" step="100"
                               class="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs font-semibold text-slate-800">
                        <button type="button" onclick="calculateInstantPrepaySavings()" class="px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-white text-xs font-semibold rounded-lg shrink-0 transition">
                            ดูผล
                        </button>
                    </div>
                    <div id="instant-prepay-result" class="mt-2 text-[11px] text-slate-600 font-medium hidden">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </div>
        </section>

        <!-- Refinance / Retention 3-Year Strategy Banner -->
        <section class="bg-amber-50/80 border border-amber-200 rounded-2xl p-5 shadow-sm space-y-3">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
                <div class="flex items-start gap-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center text-xl shrink-0 mt-0.5 shadow-sm">
                        <i class="ph-bold ph-arrows-clockwise"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2 flex-wrap">
                            <h3 class="text-sm sm:text-base font-bold text-amber-950">วางแผนขอลดดอกเบี้ยบ้าน (Retention) / รีไฟแนนซ์ทุก 3 ปี</h3>
                            <span id="retention-status-pill" class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-200/70 text-amber-800">
                                ครบกำหนดรอบแรก: ก.ย. 2572
                            </span>
                        </div>
                        <p class="text-xs text-amber-800/90 mt-0.5">
                            ดอกเบี้ยโปรโมชั่นมักครบกำหนดใน 3 ปี หากไม่ยื่นเรื่องดอกเบี้ยจะพุ่งเป็นอัตราลอยตัว MRR (~5.50%)
                        </p>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-2.5 bg-white p-2.5 rounded-xl border border-amber-200 self-start md:self-auto">
                    <span class="text-xs font-bold text-slate-700">จำลองหลังปีที่ 3:</span>
                    <select id="retention-mode-select" onchange="onRetentionModeChange()" class="text-xs font-semibold bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500">
                        <option value="retention">ยื่น Retention ต่อเนื่อง (เฉลี่ย 3.20%)</option>
                        <option value="floating">ไม่ยื่น ปล่อยลอยตัว MRR (5.50%) ⚠️</option>
                        <option value="fixed">คงที่ตามสัญญาเดิมตลอด</option>
                    </select>
                </div>
            </div>
        </section>

        <!-- Interactive Chart Section -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-100 gap-2">
                <div>
                    <h2 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2">
                        <i class="ph-bold ph-chart-line-up text-indigo-600"></i>
                        กราฟวิเคราะห์ยอดหนี้ลดลงเดือนต่อเดือน (Debt Payoff Projection)
                    </h2>
                    <p class="text-xs text-slate-500">เปรียบเทียบความเร็วในการลดลงของยอดหนี้ระหว่าง "แผนผ่อนที่คุณเลือก" เทียบกับ "จ่ายขั้นต่ำปกติ"</p>
                </div>
                <div class="flex items-center gap-2 text-xs font-semibold">
                    <span class="inline-flex items-center gap-1.5 text-indigo-600">
                        <span class="w-3 h-3 rounded-full bg-indigo-600"></span> แผนโปะของคุณ
                    </span>
                    <span class="inline-flex items-center gap-1.5 text-slate-400 ml-2">
                        <span class="w-3 h-3 rounded-full bg-slate-300"></span> จ่ายขั้นต่ำปกติ
                    </span>
                </div>
            </div>

            <div class="relative w-full h-72 sm:h-80">
                <canvas id="loanChart"></canvas>
            </div>
        </section>

        <!-- Dynamic Loan Cards Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6" id="loans-container">
            <!-- Dynamic Loan Cards populated by JS -->
        </div>

        <!-- Action Section: Record Payment & Calibrate Principle -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-2">
                <div>
                    <h2 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2">
                        <i class="ph-bold ph-plus-circle text-indigo-600"></i>
                        บันทึกการชำระเงินจริง & เปรียบเทียบแผน vs ของจริง (Actual vs Plan)
                    </h2>
                    <p class="text-xs text-slate-500">คำนวณดอกเบี้ยตามจำนวนวันจริง (Actual Days/365) และเปรียบเทียบว่าตัดเงินต้นได้ดีกว่าแผนกี่บาท</p>
                </div>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 self-start sm:self-auto border border-emerald-100">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span> ดอกเบี้ยนับวันจริงตาม Statement
                </span>
            </div>

            <!-- Form Inputs -->
            <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">เลือกก้อนหนี้</label>
                    <select id="pay-loan-id" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition">
                        <!-- Populated by JS -->
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">วันที่ทำรายการจริง</label>
                    <input type="date" id="pay-date" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">ยอดเงินที่จ่าย/โปะจริง (บาท)</label>
                    <input type="number" step="0.01" id="pay-amount" placeholder="เช่น 600, 4300 หรือยอดโปะ" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                        เงินต้นหลังจ่ายจริงในแอปธนาคาร <span class="text-indigo-600 font-normal">(ถ้าไม่ตรง)</span>
                    </label>
                    <input type="number" step="0.01" id="pay-actual-principal" placeholder="เว้นว่างได้ถ้าให้ระบบคำนวณ" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition">
                </div>
            </div>

            <!-- Action Buttons -->
