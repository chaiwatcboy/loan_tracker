        function simulatePayoffScenario(monthlyBudget) {
            if (!window.loans || window.loans.length === 0) return { months: 0, totalInterest: 0 };

            const n = window.loans.length;
            const principals = new Float64Array(n);
            const rates = new Float64Array(n);
            const minPays = new Float64Array(n);
            const isMainHome = new Uint8Array(n);

            let remainingCount = 0;
            for (let i = 0; i < n; i++) {
                const l = window.loans[i];
                principals[i] = l.principal;
                rates[i] = l.rate / 100 / 12;
                minPays[i] = l.minPay;
                isMainHome[i] = (l.id === 1 || i === 0) ? 1 : 0;
                if (principals[i] > 0) remainingCount++;
            }

            const priorityOrder = Array.from({ length: n }, (_, i) => i)
                .sort((a, b) => rates[b] - rates[a]);

            let months = 0;
            let totalInterest = 0;
            const post3YearRate1 = (currentRetentionMode === 'floating' ? 5.50 : currentRetentionMode === 'retention' ? 3.20 : window.loans[0]?.rate || 2.59) / 100 / 12;

            while (remainingCount > 0 && months < 420) {
                months++;
                let availBudget = monthlyBudget;
                let requiredMinSum = 0;

                for (let i = 0; i < n; i++) {
                    if (principals[i] <= 0) continue;
                    let r = rates[i];
                    if (isMainHome[i] && months > 36) r = post3YearRate1;
                    const interest = principals[i] * r;
                    totalInterest += interest;
                    const payMin = Math.min(principals[i] + interest, minPays[i]);
                    requiredMinSum += payMin;
                }

                availBudget = Math.max(0, availBudget - requiredMinSum);

                for (let i = 0; i < n; i++) {
                    if (principals[i] <= 0) continue;
                    let r = rates[i];
                    if (isMainHome[i] && months > 36) r = post3YearRate1;
                    const interest = principals[i] * r;
                    let pay = Math.min(principals[i] + interest, minPays[i]);
                    const prinPaid = Math.max(0, pay - interest);
                    principals[i] = Math.max(0, principals[i] - prinPaid);
                }

                if (availBudget > 0) {
                    for (let idx of priorityOrder) {
                        if (principals[idx] <= 0) continue;
                        const extra = Math.min(availBudget, principals[idx]);
                        principals[idx] -= extra;
                        availBudget -= extra;
                        if (availBudget <= 0) break;
                    }
                }

                remainingCount = 0;
                for (let i = 0; i < n; i++) {
                    if (principals[i] > 0.01) remainingCount++;
                }
            }

            return { months, totalInterest };
        }

