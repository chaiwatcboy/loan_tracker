        window.calculateReverseTargetPayoff = function() {
            if (!window.loans || window.loans.length === 0) return;
            const targetAge = parseFloat(document.getElementById('target-age-input').value) || 40;
            const currentAge = 35.0;
            const yearsAllowed = Math.max(1, targetAge - currentAge);
            const targetMonths = Math.round(yearsAllowed * 12);

            const totalMin = window.loans.reduce((sum, l) => sum + (l.minPay || 0), 0);
            let low = totalMin;
            let high = Math.max(totalMin * 4, 80000);
            let bestBudget = high;

            for (let iter = 0; iter < 12; iter++) {
                const mid = (low + high) / 2;
                const sim = simulatePayoffScenario(mid);
                if (sim.months <= targetMonths) {
                    bestBudget = mid;
                    high = mid;
                } else {
                    low = mid;
                }
            }

            const neededBudget = Math.ceil(bestBudget / 50) * 50;
            const extraFromMin = Math.max(0, neededBudget - totalMin);

            const resultContainer = document.getElementById('target-age-result');
            if (resultContainer) {
                resultContainer.innerHTML = `
